# Application
APP_NAME=MockEase
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://mockease:mockease@postgres:5432/mockease
POSTGRES_DB=mockease
POSTGRES_USER=mockease
POSTGRES_PASSWORD=mockease

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — CHANGE IN PRODUCTION
JWT_SECRET=super-secret-change-me-in-production
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
